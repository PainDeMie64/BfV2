string HandleGetMap(const string &in body)
{
    TM::GameCtnChallenge@ challenge = GetCurrentChallenge();
    if (challenge is null)
        return "{" + JsonBool("loaded", false) + "}";

    string json = "{";
    json += JsonBool("loaded", true);
    json += "," + JsonStringDisplay("name", challenge.Name);
    json += "," + JsonString("uid", challenge.Uid);
    json += "," + JsonStringDisplay("author", challenge.Author);
    json += "}";
    return json;
}

string JsonQuat(const string &in key, quat q)
{
    string obj = "{";
    obj += "\"x\":" + Text::FormatFloat(q.x, "", 0, 6);
    obj += ",\"y\":" + Text::FormatFloat(q.y, "", 0, 6);
    obj += ",\"z\":" + Text::FormatFloat(q.z, "", 0, 6);
    obj += ",\"w\":" + Text::FormatFloat(q.w, "", 0, 6);
    obj += "}";
    return "\"" + EscapeJson(key) + "\":" + obj;
}

string BuildInitialRunJson(bool includeSamples)
{
    string json = "{";
    json += JsonString("instanceUid", instanceUid);
    json += "," + JsonUInt("instancePort", localPort);
    json += "," + JsonUInt("instancePid", instancePid);
    json += "," + JsonUInt("version", g_initialRunVersion);
    json += "," + JsonBool("running", bfRunning);
    json += "," + JsonString("phase", currentPhase);
    json += "," + JsonUInt("samplePeriodMs", 10);
    json += "," + JsonBool("hasRun", g_initialRunLatest.Length > 0);
    if (!includeSamples)
    {
        json += "}";
        return json;
    }
    json += ",\"samples\":[";

    bool first = true;
    for (uint i = 0; i < g_initialRunLatest.Length; i++)
    {
        InitialRunSample@ s = g_initialRunLatest[i];
        if (s is null) continue;

        if (!first) json += ",";
        first = false;

        json += "{";
        json += JsonInt("timeMs", s.raceTimeMs);
        json += "," + JsonVec3("position", s.position);
        json += "," + JsonVec3("velocity", s.velocity);
        json += "," + JsonQuat("rotation", s.rotation);
        json += "," + JsonVec3("angularVelocity", s.angularVelocity);
        json += "}";
    }
    json += "]";
    json += "}";
    return json;
}

string HandleGetInitialRun(const string &in body)
{
    return BuildInitialRunJson(true);
}

string HandleGetInitialRunMeta(const string &in body)
{
    return BuildInitialRunJson(false);
}

string HandleGetBfSessions(const string &in body)
{
    string content = FileRead(DATA_FOLDER + "/sessions.txt");
    if (content.Length == 0) return "[]";

    array<string>@ lines = content.Split("\n");
    string json = "[";
    bool first = true;
    for (uint i = 0; i < lines.Length; i++)
    {
        if (lines[i].Length == 0) continue;
        array<string>@ parts = lines[i].Split("|");
        if (parts.Length < 4) continue;

        if (!first) json += ",";
        first = false;
        json += "{" + JsonString("id", parts[0]);
        json += "," + JsonString("target", parts[1]);
        json += "," + JsonString("startTime", parts[2]);
        json += "," + JsonString("map", parts[3]);
        json += "}";
    }
    json += "]";
    return json;
}

